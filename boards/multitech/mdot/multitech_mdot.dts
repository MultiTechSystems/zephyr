/dts-v1/;
#include <st/f4/stm32f411Xe.dtsi>
#include <st/f4/stm32f411r(c-e)tx-pinctrl.dtsi>
#include "arduino_r3_connector.dtsi" 
/* #include "st_morpho_connector.dtsi" */
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "Multitech MTDOT SX1272";
	compatible = "st,stm32f411re-nucleo";

	chosen {
		/*
		 * usart1, on PA9/PA10 -- the mDot's debug UART.
		 *
		 * This file began as an adaptation of the Nucleo-F411RE (it still
		 * declares that compatible) and inherited that board's UART
		 * mapping, which put the console on usart2/PA2-PA3. On an mDot the
		 * interface MCU is wired to PA9/PA10: mbed's target for this module
		 * defines USBTX/USBRX there, and it is confirmed on hardware.
		 *
		 * The symptom of the old mapping is the expensive one: a correctly
		 * programmed image prints NOTHING at any baud, and a break-and-DTR
		 * reset produces nothing either, which is indistinguishable from a
		 * target that never ran. It cost a bring-up before the pins were
		 * questioned.
		 */
		zephyr,console = &usart1;
		zephyr,shell-uart = &usart1;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,flash-controller = &m25p16;
	};

	leds: leds {
		compatible = "gpio-leds";
		green_led_2: led_2 {
			gpios = <&gpioa 5 GPIO_ACTIVE_HIGH>;
			label = "User LD2";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";
		user_button: button {
			label = "User";
			gpios = <&gpioc 13 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	aliases {
		led0 = &green_led_2;
		sw0 = &user_button;
		lora0 = &lora;
		flash1 = &m25p16;
	};
};

&clk_lsi {
	/* Unused now the RTC takes the LSE crystal; left off to save the power. */
	status = "disabled";
};

/* 32.768 kHz crystal, fitted on this board -- confirmed with Jason 2026-09-20,
 * and mbed agrees: MTS_MDOT_F411RE leaves target.lse_available at 1, where
 * MTS_DRAGONFLY_F411RE overrides it to 0 for a board without one.
 */
&clk_lse {
	status = "okay";
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(26)>; /* 26MHz clock */
	status = "okay";
};

&pll {
	div-m = <26>;
	mul-n = <200>;
	div-p = <2>;
	div-q = <4>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(100)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <2>;
	apb2-prescaler = <1>;
};

&usart1 {
	/* PA9/PA10, not the Nucleo's PB6/PB7 -- see the chosen node above. */
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&usart2 {
	pinctrl-0 = <&usart2_tx_pa2 &usart2_rx_pa3>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&i2c1 {
	pinctrl-0 = <&i2c1_scl_pb8 &i2c1_sda_pb9>;
	pinctrl-names = "default";
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
};

&i2c2 {
	pinctrl-0 = <&i2c2_scl_pb10 &i2c2_sda_pb3>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;
};

&i2c3 {
	pinctrl-0 = <&i2c3_scl_pa8 &i2c3_sda_pb4>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;
};

&i2s1 {
	pinctrl-0 = <&i2s1_ck_pa5 &i2s1_sd_pa7>;
	pinctrl-names = "default";
};

&spi2 {
	pinctrl-0 = <&spi2_nss_pb12 &spi2_sck_pb13
		     &spi2_miso_pb14 &spi2_mosi_pb15>;
	pinctrl-names = "default";
	status = "okay";

	lora: spi2@0 {
		compatible = "semtech,sx1272";
		reg = <0x0>;
		spi-max-frequency = <DT_FREQ_M(1)>;

		reset-gpios = <&gpiob 0 GPIO_ACTIVE_HIGH>;   /* A0 */

		dio-gpios = <&gpiob 5 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>,	   /* DIO0 is D2 */
		            <&gpiob 6 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>,	   /* DIO1 is D3 */
			    <&gpiob 7 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>,	   /* DIO2 is D4 */
			    <&gpiob 8 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>,    /* DIO3 is D5 */
				<&gpiob 9 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>;	   /* DIO4 is D5 */

		power-amplifier-output = "pa-boost";
	};
};

&spi3 {
	pinctrl-0 = <&spi3_sck_pc10
		     &spi3_miso_pc11 &spi3_mosi_pc12>;
	pinctrl-names = "default";
	status = "okay";

	cs-gpios = <&gpioc 6 (GPIO_ACTIVE_LOW | GPIO_PULL_DOWN)>;

	m25p16: m25p16@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(26)>;

		size = <0x200000>;
		page-size = <256>;

		has-dpd;
		t-enter-dpd = <10000>;
		t-exit-dpd = <35000>;
		has-lock = <0x06>;
		
		#wp-gpios = <&gpioc 8 (GPIO_ACTIVE_LOW | GPIO_PULL_DOWN)>;
		hold-gpios = <&gpioc 7 (GPIO_ACTIVE_LOW | GPIO_PULL_DOWN)>;

		jedec-id = [20 20 15];
		status = "okay";
	};
};

/* THE RTC RUNS ON THE LSE CRYSTAL, NOT THE INTERNAL RC.
 *
 * This said STM32_SRC_LSI RTC_SEL(2) -- the internal RC -- and declared no
 * clk_lse node at all, so the 32.768 kHz crystal this board carries could not
 * be reached. An LSI is a percent-level part: 1% is 10,000 ppm against a
 * crystal specified at 20 ppm, so any Class B ping-slot budget computed on it
 * is meaningless, and the error is 500x the effects we spend days measuring.
 *
 * It was almost certainly inherited rather than chosen: every upstream ST F4
 * board, nucleo_f411re included, selects LSI here, and a Nucleo often ships
 * with its LSE crystal footprint unpopulated. Correct for those boards. Not
 * correct for this one.
 *
 * It stayed invisible because nothing measured runs through it -- the timing
 * work is mbed-side on the MAX32670 xDot, so no number this tree produces has
 * ever depended on this selector.
 *
 * NOTE FOR THE FIRST BOOT ON REAL HARDWARE. Zephyr's STM32 clock driver waits
 * for LSE with an UNBOUNDED spin (clock_stm32_ll_common.c, "while
 * (!LL_RCC_LSE_IsReady()) {}"). If the crystal is absent or will not start, the
 * board hangs there before main with no console output and no fault -- which
 * reads as dead hardware. That is the same failure shape that bit the xDot ES
 * ERTCO wait. If this board goes silent after this change, that loop is where
 * it is.
 */
&rtc {
	clocks = <&rcc STM32_CLOCK_BUS_APB1 0x10000000>,
		 <&rcc STM32_SRC_LSE RTC_SEL(1)>;
	status = "okay";
};
